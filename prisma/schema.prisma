// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JenisKelamin {
  PRIA
  WANITA
}

enum SectionType {
  ABOUT
  RESUME
}

enum ItemKind {
  FILE
  FOLDER
}

enum ItemType {
  PROJECT_INFO
  TECHSTACK
  FIG
  URL
  TXT
  IMG
  PDF
  OTHER
  CONTACT
}

model Category {
  id        String    @id @default(uuid())
  name      Json      // Multilingual
  icon      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  contacts  Contact[]
  profiles  Profile[]
  educations Education[]
  experiences Experience[]
  projects  Project[]
}

model Contact {
  id          String    @id @default(uuid())
  title       String
  description Json      // Multilingual
  tooltipText Json?     // Multilingual
  icon        String?
  bgColor     String?
  contactURL  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
}

model Profile {
  id          String    @id @default(uuid())
  name       String    // Internal identifier (not translated)
  fullName String
  jenisKelamin        JenisKelamin  // UI will translate enum values
  role     Json       // Multilingual
  quote  Json         // Multilingual
  photoURL   String?
  birthDate  DateTime?
  birthPlace String?
  experienceYears Int?

  description Json?    // Multilingual

  address    Json?     // Multilingual
  lat  Float?
  lng Float?
  mapURL    String?

  preferredLanguages Json?  // ["en", "ja", "zh"] - User's language preferences

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])

  items           ProfileItem[]
}

model ProfileItem {
  id           String     @id @default(uuid())

  // ownership
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id])

  // explorer structure
  name         Json       // Multilingual
  kind         ItemKind
  fileType     ItemType?

  parentId     String?
  parent       ProfileItem? @relation("ProfileItemTree", fields: [parentId], references: [id])
  children     ProfileItem[] @relation("ProfileItemTree")

  // ui / content
  icon         String?
  imageUrl     String?
  href         String?
  subtitle     Json?     // Multilingual
  description  Json?     // Multilingual
  tooltipText  Json?     // Multilingual

  extra        Json?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Education {
  id          String    @id @default(uuid())
  school      String
  major      Json       // Multilingual
  startYear Int
  endYear   Int
  schoolLogo       String?
  icon  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

   categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
}

model Experience {
  id          String    @id @default(uuid())
  company      String
  role      Json        // Multilingual
  location   String
  start String
  end   String
  jobdesk       Json?    // Multilingual
  description  Json?    // Multilingual
  icon  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
}

model Project {
  id          String         @id @default(uuid())
  name        Json       // Multilingual
  description  Json          // Multilingual
  progressValue Int
  demoURL    String?
  repoURL    String?
  icon        String
  subIcon     String?
  tooltipText Json?          // Multilingual
  techStack   Json?

  entries     ProjectEntry[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
}


model ProjectEntry {
  id           String        @id @default(uuid())

  // struktur project
  name         Json          // Multilingual
  kind         ItemKind
  fileType         ItemType?

  parentId     String?
  parent       ProjectEntry? @relation("ProjectEntryTree", fields: [parentId], references: [id])
  children     ProjectEntry[]@relation("ProjectEntryTree")

  // relasi ke project
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id])

  // UI & metadata
  icon         String?
  subIcon      String?
  tooltipText  Json?         // Multilingual

  // konten
  href         String?
  imageUrl     String?
  subtitle     Json?         // Multilingual
  progress     Int?

  description  Json?         // Multilingual
  techStack    Json?
  extra        Json?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}



